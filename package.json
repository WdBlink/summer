{
  "name": "summer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Protocol-first agent workflow orchestration with pluggable runtimes.",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "summer": "tsc -b packages/cli --pretty false && node packages/cli/dist/cli.js",
    "validate": "pnpm typecheck && pnpm test && pnpm skill:validate",
    "skill:validate": "node scripts/validate-skill.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
