{
  "schemaVersion": "summer.workflow/v1",
  "workflowId": "factor-discovery-tuning",
  "revision": 1,
  "profile": {
    "kind": "iterative-campaign",
    "terminalNodeIds": ["terminal"],
    "activationNodeId": "activate",
    "iterationNodeId": "plan-generation",
    "experimentNodeId": "run-experiment",
    "budgetNodeId": "check-budget",
    "frameCheckNodeId": "frame-check",
    "decisionNodeId": "decide",
    "budgets": {
      "maxExperiments": 2,
      "maxAttemptsPerExperiment": 2,
      "maxTotalNodeExecutions": 32
    }
  },
  "entryNodeId": "activate",
  "nodes": [
    { "id": "activate", "component": { "namespace": "summer", "name": "activation-policy", "version": "1.0.0" } },
    { "id": "plan-generation", "component": { "namespace": "factor", "name": "iteration-policy", "version": "1.0.0" } },
    { "id": "run-experiment", "join": "any", "component": { "namespace": "factor", "name": "strategy-experiment", "version": "1.0.0" }, "maxAttempts": 2, "idempotencyKey": "experiment-id:attempt-id" },
    { "id": "wait-state", "component": { "namespace": "summer", "name": "wait-state", "version": "1.0.0" } },
    { "id": "frame-check", "join": "any", "component": { "namespace": "summer", "name": "frame-check-policy", "version": "1.0.0" } },
    { "id": "check-budget", "component": { "namespace": "summer", "name": "budget-policy", "version": "1.0.0" } },
    { "id": "decide", "component": { "namespace": "summer", "name": "decision-policy", "version": "1.0.0" } },
    { "id": "terminal", "component": { "namespace": "summer", "name": "terminal-receipt", "version": "1.0.0" } }
  ],
  "edges": [
    { "id": "activate-experiment", "from": "activate", "to": "run-experiment", "condition": { "kind": "node-succeeded" } },
    { "id": "experiment-frame", "from": "run-experiment", "to": "frame-check", "condition": { "kind": "node-succeeded" } },
    { "id": "wait-frame", "from": "wait-state", "to": "frame-check", "condition": { "kind": "node-succeeded" } },
    { "id": "frame-budget", "from": "frame-check", "to": "check-budget", "condition": { "kind": "node-succeeded" } },
    { "id": "budget-plan", "from": "check-budget", "to": "plan-generation", "condition": { "kind": "node-succeeded" } },
    { "id": "plan-decision", "from": "plan-generation", "to": "decide", "condition": { "kind": "node-succeeded" } },
    { "id": "decision-replicate", "from": "decide", "to": "run-experiment", "condition": { "kind": "decision-is", "decision": "replicate" } },
    { "id": "decision-repair", "from": "decide", "to": "run-experiment", "condition": { "kind": "decision-is", "decision": "repair-runtime" } },
    { "id": "decision-next", "from": "decide", "to": "run-experiment", "condition": { "kind": "decision-is", "decision": "run-next-experiment" } },
    { "id": "decision-recompile", "from": "decide", "to": "run-experiment", "condition": { "kind": "decision-is", "decision": "recompile-hypothesis" } },
    { "id": "decision-wait", "from": "decide", "to": "wait-state", "condition": { "kind": "decision-is", "decision": "wait" } },
    { "id": "decision-stop", "from": "decide", "to": "terminal", "condition": { "kind": "decision-is", "decision": "stop" } }
  ],
  "metadata": {
    "scope": "two-generation mechanical conformance; no live trading",
    "factorLoopCompatibility": false
  }
}
