{
  "name": "@summer/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "summer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src"
  },
  "dependencies": {
    "@summer/catalog": "workspace:*",
    "@summer/compiler": "workspace:*",
    "@summer/components": "workspace:*",
    "@summer/protocol": "workspace:*",
    "@summer/research-ideation": "workspace:*",
    "@summer/runtime-mastra": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
